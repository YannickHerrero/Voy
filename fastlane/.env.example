# App Store Connect API key metadata. Keep real values in ignored fastlane/.env.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Optional; defaults to ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
ASC_KEY_PATH=

# Apple Developer Portal login used to create and associate the CloudKit container.
# Fastlane reuses the password stored in the macOS keychain and its private local session.
APPLE_ID=
APPLE_TEAM_ID=KY6RHJR4LZ
